{
  "name": "map-manager-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "npm run --prefix ../map-manager export-openapi && openapi --input ../map-manager/openapi.json --output src/api/generated/openapi --client fetch --useOptions --useUnionTypes --exportCore true --exportServices true --exportModels true --indent 2",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
